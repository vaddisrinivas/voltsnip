DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moltsnip
S3_BUCKET_NAME=local-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_MODE=local
STORAGE_URI=local_s3

# Cost & Safety Guards
EMBEDDINGS_ENABLED=True
TRENDING_WINDOW_DAYS=7
MAX_CODE_SIZE=100000
MAX_SEARCH_K=100

# CORS Support: "*" or "http://localhost:3000,http://example.com" or '["*"]'
CORS_ORIGINS="*"
