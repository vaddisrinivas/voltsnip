43. \n44.     def __init__(self, config: PartitionConfig | None = None) -> None:\n45.         self._config = config or PartitionConfig()\n46.         self._ring: list[tuple[\n\nint, int]] = []\n47.         self._build_ring()\n48. \n49.     # ------------------------------------------------------------------\n50.     # Ring construction\n51.     # ------------------------------------------------------------------\n52. \n53.     def _build_ring(self) -> None:\n54.         \"\"\"Pre-compute virtual-node positions on the ring.\"\"\"\n55.         for part_id in range(self._config.num_partitions):\n56.             for replica in range(self._config.replicas_per_node):\n57.                 vnode_key = f\"part-{part_id}-rep-{replica}\"\n58.                 position = _stable_hash(vnode_key, self._config.hash_algorithm)\n59.                 self._ring.append((position, part_id))\n60.         self._ring.sort()\n61. \n62.     # ------------------------------------------------------------------\n63.     # Assignment\n64.     # ------------------------------------------------------------------\n65. \n66.     def assign_partition(self, key: str, num_partitions: int | None = None) -> int:\n67.         \"\"\"Return the partition ID for *key*.\n68. \n69.         BUG_58: uses ``hash(key) % (num_partitions + 1)`` which can\n70.         return ``num_partitions`` itself -- an out-of-range value\n71.         (valid range is ``0 .. num_partitions - 1``).  The fix must\n72.         use ``hash(key) % num_partitions`` instead.\n73.         \"\"\"\n74.         n = num_partitions if num_partitions is not None else self._config.num_partitions\n75.         # BUG_58: off-by-one in modulus -- can return n itself\n76.         partition_id = _stable_hash(key) % (n + 1)\n77.         return partition_id\n\nThe issue is on line 76 where the modulus operation uses `(n + 1)` instead of just `n`. This causes the function to potentially return `num_partitions` itself, which exceeds the valid range of `0` to