{"type":"item.completed","item":{"id":"item_20","type":"agent_message","text":"{\"code\":\"    def rollback_to_savepoint(self, savepoint_id: str) -> None:\\n        \\\"\\\"\\\"Rollback to a named savepoint.\\n\\n        BUG_49: After ROLLBACK TO SAVEPOINT the savepoint still exists on\\n        the server but is never released, leaking the resource.  The\\n        function also does not annotate the trace span with the rollback\\n        event for observability.\\n        \\\"\\\"\\\"\\n        self.session.execute(\\n            f\\\"ROLLBACK TO SAVEPOINT {savepoint_id}\\\"\\n        )  # BUG_49: missing RELEASE after ROLLBACK leaks savepoint resource\\n        self.release_savepoint(savepoint_id)\\n        from orgops.tracing import annotate_span\\n\\n        annotate_span(\\n            \\\"transaction.rollback_to_savepoint\\\",\\n            {\\\"savepoint_id\\\": savepoint_id},\\n        )\",\"comments\":\"Releases the savepoint after rollback and annotates the span with the rollback event.\"}"}}
