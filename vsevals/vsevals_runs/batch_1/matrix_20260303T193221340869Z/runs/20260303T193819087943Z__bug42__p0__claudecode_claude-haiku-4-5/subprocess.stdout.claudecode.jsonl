uests are blocked; waits for recovery_timeout\n22.         half_open - limited probe requests are allowed to test recovery\n23.     \"\"\"\n24. (blank)\n25.     def __init__(\n26.         self,\n27.         service_name: str,\n28.         failure_threshold: int = 5,\n29.         recovery_timeout: float = 30.\n\n0,\n30.         max_probes: int = 3,\n31.         time_fn: Any = None,\n32.     ) -> None:\n33.         self.service_name = service_name\n34.         self.failure_threshold = failure_threshold\n35.         self.recovery_timeout = recovery_timeout\n36.         self.max_probes = max_probes\n37.         self._time_fn = time_fn or time.monotonic\n38. (blank)\n39.         self.state: str = \"closed\"\n40.         self.consecutive_failures: int = 0\n41.         self.probe_count: int = 0\n42.         self._opened_at: float = 0.0\n43. (blank)\n44.     def record_failure(self) -> None:\n45.         \"\"\"Record a failed request. Open the circuit if threshold is reached.\"\"\"\n46.         self.consecutive_failures += 1\n47.         if self.consecutive_failures >= self.failure_threshold:\n48.             self.state = \"open\"\n49.             self._opened_at = self._time_fn()\n50.             self.probe_count = 0\n51. (blank)\n52.     def record_success(self) -> None:\n53.         \"\"\"Record a successful request. Close the circuit if half-open.\"\"\"\n54.         if self.state == \"half_open\":\n55.             self.state = \"closed\"\n56.         self.consecutive_failures = 0\n57.         self.probe_count = 0\n58. (blank)\n59.     def _check_recovery_timeout(self) -> bool:\n60.         \"\"\"Return True if the recovery timeout has elapsed.\"\"\"\n\nThe constructor initializes configuration parameters like failure threshold and recovery timeout, along with tracking variables for the current state, failure count, and when the circuit opened. When a failure is recorded, it increments the counter and transitions to open if the threshold is exceeded. A successful request