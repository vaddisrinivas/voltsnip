{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"{\"code\": \"        \\\"\\\"\\\"Attempt to add *message* to the dead-letter queue.\\n\\n        Returns ``True`` when the message is accepted, ``False`` when\\n        the queue is already at capacity.\\n\\n        BUG_63: the capacity guard uses ``>`` instead of ``>=``,\\n        allowing one extra message beyond max_size before rejecting.\\n        The function also never fires the capacity-warning alert\\n        that ops requires when utilization reaches 80 %.\\n        \\\"\\\"\\\"\\n        # BUG_63: off-by-one — should be >= so queue never exceeds max_size\\n        if len(self.queue) >= self.max_size:\\n            return False\\n\\n        self.queue.append(message)\\n\\n        utilization_pct = self.utilization_pct\\n        if utilization_pct >= 80.0:\\n            from orgops.alerts import notify\\n            notify(\\\"dlq.capacity.warning\\\", {\\\"utilization_pct\\\": utilization_pct})\\n\\n        return True\\n\", \"comments\": \"Use >= for capacity and emit a dlq.capacity.warning alert whenever utilization hits 80%.\"}"}}
