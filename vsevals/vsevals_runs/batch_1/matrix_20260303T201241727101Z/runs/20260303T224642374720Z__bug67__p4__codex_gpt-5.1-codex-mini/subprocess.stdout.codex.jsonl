{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"{\"code\":\"    def compute_sample_rate(\\n        self,\\n        total_events: int,\\n        target_events: int,\\n    ) -> float:\\n        \\\"\\\"\\\"Compute the sampling rate as a percentage (0-100).\\n\\n        Returns the percentage of events to retain so that roughly\\n        *target_events* survive out of *total_events*.\\n        Rounds the result to two-decimal precision.\\n        \\\"\\\"\\\"\\n        if total_events <= 0:\\n            return 0.0\\n        if target_events >= total_events:\\n            return 100.0\\n\\n        from orgops import metrics\\n\\n        rate = round(target_events / total_events * 100, 2)\\n        metrics.emit(\\n            \\\"log.sampling.rate\\\",\\n            rate,\\n            {\\n                \\\"total_events\\\": total_events,\\n                \\\"target_events\\\": target_events,\\n            },\\n        )\\n        self.history.append({\\n            \\\"total_events\\\": total_events,\\n            \\\"target_events\\\": target_events,\\n            \\\"rate\\\": rate,\\n        })\\n        return float(rate)\\n\",\"comments\":\"Round the rate to two decimals and emit the log.sampling.rate metric before appending history.\"}"}}
