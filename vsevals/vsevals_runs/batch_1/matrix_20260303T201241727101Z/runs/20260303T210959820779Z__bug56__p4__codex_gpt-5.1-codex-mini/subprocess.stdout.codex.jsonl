{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"{\"code\":\"    def compute_lfu_score(\\n        self,\\n        access_count: int,\\n        age_hours: float,\\n    ) -> float:\\n        \\\"\\\"\\\"Compute the LFU eviction score for a cache entry.\\n\\n        BUG_56: returns the raw *access_count* without any time-decay\\n        factor.  The correct formula is:\\n\\n            score = access_count / (1 + age_hours)\\n\\n        so that older entries naturally decay and do not hog the cache\\n        forever based on historical popularity alone.\\n        \\\"\\\"\\\"\\n        score = access_count / (1 + age_hours)\\n        try:\\n            from cache import metrics as _metrics\\n        except ImportError:\\n            _metrics = None\\n        if _metrics is not None:\\n            if hasattr(_metrics, \\\"gauge\\\"):\\n                _metrics.gauge(\\\"cache.eviction.lfu\\\", value=score)\\n            elif hasattr(_metrics, \\\"emit\\\"):\\n                _metrics.emit(\\\"cache.eviction.lfu\\\", value=score)\\n            elif hasattr(_metrics, \\\"record\\\"):\\n                _metrics.record(\\\"cache.eviction.lfu\\\", value=score)\\n        return float(score)\\n\",\"comments\":\"Apply time-decayed LFU scoring and emit the cache.eviction.lfu metric when available.\"}"}}
