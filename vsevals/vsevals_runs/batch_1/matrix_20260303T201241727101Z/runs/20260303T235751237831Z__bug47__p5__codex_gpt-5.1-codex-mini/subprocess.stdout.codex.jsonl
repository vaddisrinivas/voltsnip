{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"{\"code\":\"    def evict_idle(self) -> Connection | None:\\n        \\\"\\\"\\\"Remove the least-recently-used idle connection.\\n\\n        BUG_47: uses ``self.connections.pop(0)`` which removes the\\n        *first-inserted* connection (FIFO order) rather than the one\\n        with the oldest ``last_used_at`` timestamp (LRU order).  When\\n        connections are touched out of insertion order, the wrong\\n        connection is evicted.\\n        \\\"\\\"\\\"\\n        if not self.connections:\\n            return None\\n\\n        now = time.time()\\n\\n        oldest_index = min(\\n            range(len(self.connections)),\\n            key=lambda index: self.connections[index].last_used_at,\\n        )\\n        evicted = self.connections.pop(oldest_index)\\n\\n        idle_seconds = now - evicted.last_used_at\\n\\n        emitter = getattr(self, \\\"metrics\\\", None)\\n        if emitter and hasattr(emitter, \\\"emit\\\"):\\n            emitter.emit(\\\"pool.connection.evicted\\\", {\\\"idle_seconds\\\": idle_seconds})\\n        elif callable(getattr(self, \\\"emit_metric\\\", None)):\\n            self.emit_metric(\\\"pool.connection.evicted\\\", {\\\"idle_seconds\\\": idle_seconds})\\n\\n        return evicted\",\"comments\":\"Evicts the idle connection with the oldest last_used_at timestamp, pops it by index, and reports a pool.connection.evicted metric when a compatible emitter is attached.\"}"}}
