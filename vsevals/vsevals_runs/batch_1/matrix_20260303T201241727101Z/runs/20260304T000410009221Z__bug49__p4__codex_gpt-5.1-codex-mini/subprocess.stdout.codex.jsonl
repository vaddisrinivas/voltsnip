{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"{\"code\":\"    def rollback_to_savepoint(self, savepoint_id: str) -> None:\\n        \\\"\\\"\\\"Rollback to a named savepoint.\\n\\n        BUG_49: After ROLLBACK TO SAVEPOINT the savepoint still exists on\\n        the server but is never released, leaking the resource.  The\\n        function also does not annotate the trace span with the rollback\\n        event for observability.\\n        \\\"\\\"\\\"\\n        self.session.execute(\\n            f\\\"ROLLBACK TO SAVEPOINT {savepoint_id}\\\"\\n        )\\n        self.release_savepoint(savepoint_id)\\n        import orgops\\n        orgops.tracing.annotate_span(\\n            \\\"db.savepoint.rollback\\\",\\n            {\\\"savepoint_id\\\": savepoint_id},\\n        )\",\"comments\":\"Add savepoint release after rollback and annotate the trace span via orgops.tracing so the savepoint resource is freed and the rollback is observable.\"}"}}
