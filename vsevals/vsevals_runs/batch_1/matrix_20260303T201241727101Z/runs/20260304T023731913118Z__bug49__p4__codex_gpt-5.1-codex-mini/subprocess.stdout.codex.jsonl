{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"{\"code\": \"    def rollback_to_savepoint(self, savepoint_id: str) -> None:\\n        \\\"\\\"\\\"Rollback to a named savepoint.\\n\\n        BUG_49: After ROLLBACK TO SAVEPOINT the savepoint still exists on\\n        the server but is never released, leaking the resource.  The\\n        function also does not annotate the trace span with the rollback\\n        event for observability.\\n        \\\"\\\"\\\"\\n        import orgops.tracing\\n\\n        self.session.execute(\\n            f\\\"ROLLBACK TO SAVEPOINT {savepoint_id}\\\"\\n        )\\n        self.session.execute(\\n            f\\\"RELEASE SAVEPOINT {savepoint_id}\\\"\\n        )\\n        orgops.tracing.annotate_span(\\n            \\\"rollback_to_savepoint\\\",\\n            {\\\"savepoint_id\\\": savepoint_id},\\n        )\\n        if savepoint_id in self._active_savepoints:\\n            self._active_savepoints.remove(savepoint_id)\\n\", \"comments\": \"Release the savepoint after rollback, annotate the trace span, and drop it from the active list.\"}"}}
