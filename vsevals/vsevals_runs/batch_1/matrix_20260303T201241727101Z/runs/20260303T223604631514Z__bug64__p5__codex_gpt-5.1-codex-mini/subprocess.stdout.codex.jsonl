{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"{\"code\":\"    def escalate_timeout(\\n        self,\\n        original_ms: float,\\n        attempt: int,\\n        multiplier: float = 1.5,\\n    ) -> dict[str, Any]:\\n        \\\"\\\"\\\"Compute the escalated timeout for *attempt*.\\n\\n        BUG_64: the calculation uses ``original_ms * multiplier`` on every\\n        attempt instead of compounding (``original_ms * (multiplier ** attempt)``).\\n        This means every retry gets the same timeout regardless of the\\n        attempt number, eliminating the exponential back-pressure that\\n        protects recovering services.\\n        \\\"\\\"\\\"\\n        new_timeout_ms = min(original_ms * (multiplier ** attempt), self.ceiling_ms)\\n\\n        from orgops import metrics as orgops_metrics\\n\\n        orgops_metrics.emit(\\n            \\\"timeout.escalated\\\",\\n            value=new_timeout_ms,\\n            tags={\\\"attempt\\\": attempt},\\n        )\\n\\n        record: dict[str, Any] = {\\n            \\\"attempt\\\": attempt,\\n            \\\"original_ms\\\": original_ms,\\n            \\\"new_timeout_ms\\\": new_timeout_ms,\\n        }\\n        self.history.setdefault(\\\"default\\\", []).append(record)\\n\\n        return {\\n            \\\"original_ms\\\": original_ms,\\n            \\\"new_timeout_ms\\\": new_timeout_ms,\\n            \\\"attempt\\\": attempt,\\n            \\\"capped\\\": new_timeout_ms >= self.ceiling_ms,\\n        }\\n\", \"comments\":\"Compound timeout per attempt and emit timeout.escalated metric via orgops.metrics.emit.\"}"}}
