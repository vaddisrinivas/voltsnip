{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"{\"code\":\"    def sanitize_email(self, text: str) -> str:\\n        \\\"\\\"\\\"Replace all email addresses with ``[REDACTED_EMAIL]``.\\n\\n        BUG_65: the regex ``[\\\\w.]+@[\\\\w.]+`` does not include ``+``\\n        in the local-part character class, so plus-addressed emails\\n        like ``user+tag@domain.com`` are **not** redacted.\\n        Should be ``[\\\\w.+]+@[\\\\w.]+``.\\n        \\\"\\\"\\\"\\n        email_re = re.compile(r\\\"[\\\\w.+]+@[\\\\w.]+\\\")\\n        result = email_re.sub(_REDACTED_EMAIL, text)\\n        count = len(email_re.findall(text))\\n        self._history.append(\\n            SanitizationResult(text=result, emails_redacted=count)\\n        )\\n        try:\\n            from orgops import compliance as _compliance\\n        except ImportError:\\n            _compliance = None\\n        if _compliance:\\n            _compliance.record_decision(\\n                \\\"pii.sanitized\\\",\\n                {\\\"emails_redacted\\\": count, \\\"sanitizer\\\": \\\"sanitize_email\\\"},\\n            )\\n        return result\\n\", \"comments\":\"Sanitize plus-addressed emails via a local regex and log the pii.sanitized compliance decision.\"}"}}
