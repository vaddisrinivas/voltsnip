{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"{\"code\":\"    def should_refresh_early(\\n        self,\\n        time_remaining: float,\\n        ttl: float,\\n        key_name: str = \\\"unknown\\\",\\n    ) -> bool:\\n        \\\"\\\"\\\"Return True when the entry should be refreshed before expiry.\\n\\n        Trigger early refresh when the remaining fraction of the TTL falls\\n        below the configured threshold so a new value is ready before expiry.\\n        \\\"\\\"\\\"\\n        if ttl <= 0:\\n            return False\\n\\n        ratio = time_remaining / ttl\\n\\n        # Early refresh should fire only when we're close to expiry.\\n        if ratio < self.threshold:\\n            self.refreshes_triggered += 1  # increments cache.stampede.prevented metric\\n            return True\\n\\n        return False\",\"comments\":\"Fixes the threshold comparison so refreshes fire near expiry and documents that incrementing the counter backs the cache.stampede.prevented metric.\"}"}}
