{"type":"item.completed","item":{"id":"item_23","type":"agent_message","text":"{\"code\": \"    def get_pending_migrations(self) -> list[dict[str, Any]]:\\n        \\\"\\\"\\\"Return migrations not yet applied, sorted by version.\\n\\n        BUG_48: versions are compared as *strings* so lexicographic\\n        ordering causes \\\"10\\\" to sort before \\\"2\\\" and pending detection\\n        incorrectly skips higher single-digit versions.\\n        \\\"\\\"\\\"\\n        from orgops import auditing\\n\\n        def version_number(value: Any) -> int:\\n            return int(str(value))\\n\\n        if not self.applied_versions:\\n            pending = sorted(\\n                self.available_migrations,\\n                key=lambda m: version_number(m[\\\"version\\\"]),\\n            )\\n        else:\\n            max_applied = max(version_number(v) for v in self.applied_versions)\\n            pending = [\\n                m\\n                for m in self.available_migrations\\n                if version_number(m[\\\"version\\\"]) > max_applied\\n            ]\\n            pending = sorted(pending, key=lambda m: version_number(m[\\\"version\\\"]))\\n\\n        for migration in pending:\\n            auditing.write_event(\\\"migration.applied\\\", version=str(migration[\\\"version\\\"]))\\n\\n        return pending\\n\", \"comments\": \"Parse versions numerically, filter accordingly, and emit the required audit event for every migration returned as pending.\"}"}}
