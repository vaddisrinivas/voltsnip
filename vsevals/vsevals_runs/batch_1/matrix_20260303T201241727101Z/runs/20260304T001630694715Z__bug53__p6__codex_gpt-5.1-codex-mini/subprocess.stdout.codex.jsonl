{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"{\"code\":\"    def acquire_lock(\\n        self,\\n        key: str,\\n        timeout_ms: int,\\n        clock_skew_ms: int = 0,\\n    ) -> dict[str, Any]:\\n        \\\"\\\"\\\"Acquire a distributed lock on *key* with adjusted timeout.\\n\\n        BUG_53: the effective timeout is computed as timeout_ms - clock_skew_ms\\n        without clamping.  When clock_skew_ms > timeout_ms the effective\\n        timeout goes negative, causing immediate expiry or backend errors.\\n        The effective timeout is now clamped to at least 1 ms before tracing.\\n        \\\"\\\"\\\"\\n        from orgops import tracing\\n\\n        effective_timeout = max(1, timeout_ms - clock_skew_ms)\\n        tracing.annotate_span(\\n            key=key,\\n            requested_timeout_ms=timeout_ms,\\n            clock_skew_ms=clock_skew_ms,\\n            effective_timeout_ms=effective_timeout,\\n        )\\n        self.store[key] = {\\n            \\\"acquired_at\\\": time.monotonic(),\\n            \\\"timeout_ms\\\": effective_timeout,\\n        }\\n        self.held_keys.add(key)\\n        return {\\n            \\\"key\\\": key,\\n            \\\"effective_timeout_ms\\\": effective_timeout,\\n            \\\"acquired\\\": True,\\n        }\\n\", \"comments\":\"Clamp the timeout to at least 1 ms and annotate the span while keeping the existing return payload.\"}"}}
